{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "tsc",
    "dev:nodemon": "nodemon ./dist/main.js",
    "dev:watch": "webpack --watch",
    "dev": "kill-port $SERVER_PORT && wait-on tcp:$MOCKS_PORT && concurrently \"yarn dev:nodemon\" \"yarn dev:watch\"",
    "start": "concurrently \"yarn dev:nodemon\" \"yarn dev:watch\"",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@apollo/datasource-rest": "^6.4.1",
    "@apollo/server": "^5.0.0",
    "dotenv": "^17.3.1",
    "graphql": "^16.11.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.4.2",
    "jest": "^30.0.5",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "kill-port": "^2.0.1",
    "wait-on": "^8.0.4",
    "concurrently": "^9.2.0"
  }
}
